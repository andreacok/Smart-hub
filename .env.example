# Copia questo file in ".env" (non viene committato) e personalizza i valori.

# --- Modalità -----------------------------------------------------------------
# mock = casa demo simulata (nessun account necessario)
# live = account SmartThings reale
SMARTTHINGS_MODE=mock

# --- Autenticazione SmartThings (solo live) ----------------------------------
# pat   = Personal Access Token (semplice, ma i nuovi token durano 24 ore)
# oauth = OAuth-In SmartApp con rinnovo automatico (consigliato per un hub sempre acceso)
SMARTTHINGS_AUTH=pat

# Personal Access Token da https://account.smartthings.com/tokens
SMARTTHINGS_TOKEN=

# OAuth (vedi README, sezione "Modalità LIVE con OAuth")
SMARTTHINGS_OAUTH_CLIENT_ID=
SMARTTHINGS_OAUTH_CLIENT_SECRET=
SMARTTHINGS_OAUTH_REDIRECT_URI=
# opzionale: refresh token ottenuto a mano
SMARTTHINGS_OAUTH_REFRESH_TOKEN=

# Location da usare (vuoto = la prima dell'account)
SMARTTHINGS_LOCATION_ID=

# --- Avanzate (i default vanno bene) -----------------------------------------
SMARTTHINGS_BASE_URL=https://api.smartthings.com/v1
SMARTTHINGS_STATUS_REFRESH_INTERVAL=5s
SMARTTHINGS_STRUCTURE_REFRESH_INTERVAL=5m
SMARTTHINGS_REQUEST_TIMEOUT=10s

# Nome mostrato nel saluto ("Buonasera, Andrea")
SMARTHUB_OWNER_NAME=

# Cartella dei dati runtime: foto personalizzate delle stanze (default ./data; in Docker è /data)
# SMARTHUB_DATA_DIR=./data

# Swagger UI (/swagger-ui.html) e specifica OpenAPI (/v3/api-docs)
SMARTHUB_API_DOCS_ENABLED=true

# Porta della dashboard con docker compose
SMARTHUB_PORT=8088

# Solo mock: probabilità di errore dei comandi (0.0 - 1.0) per provare il rollback in UI
SMARTTHINGS_MOCK_FAILURE_RATE=0.0
